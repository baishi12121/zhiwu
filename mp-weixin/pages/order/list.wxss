.order-list-page{min-height:100vh;background:#f7f8fa;padding-bottom:40rpx}
.tab-bar{white-space:nowrap;background:#fff;padding:20rpx 24rpx;position:sticky;top:0;z-index:10}
.tab-item{display:inline-block;padding:12rpx 28rpx;margin-right:16rpx;font-size:26rpx;color:#667085;background:#f4f5f7;border-radius:999rpx;transition:all .2s ease}
.tab-item.active{color:#fff;background:linear-gradient(135deg,#ff6a6b,#ff8d63);font-weight:600}
.empty{padding:40rpx 24rpx}
.placeholder-card{width:100%;background:#fff;border-radius:32rpx;border:2rpx dashed #e4e7ec;padding:80rpx 48rpx;display:flex;flex-direction:column;align-items:center;box-shadow:0 8rpx 24rpx rgba(15,23,42,.04)}
.placeholder-icon{width:140rpx;height:140rpx;border-radius:50%;font-size:60rpx;display:flex;align-items:center;justify-content:center;margin-bottom:32rpx}
.placeholder-title{font-size:36rpx;font-weight:700;color:#1f2937;margin-bottom:16rpx}
.placeholder-desc{font-size:26rpx;color:#667085;text-align:center;line-height:1.6;margin-bottom:48rpx}
.placeholder-btn{min-width:320rpx;height:80rpx;padding:0 32rpx;border-radius:999rpx;color:#fff;font-size:28rpx;font-weight:600;display:flex;align-items:center;justify-content:center}
.placeholder-btn:active{transform:scale(.96);opacity:.85}
.order-list{padding:20rpx 24rpx;display:flex;flex-direction:column;gap:20rpx}
.order-card{background:#fff;border-radius:24rpx;padding:24rpx;box-shadow:0 4rpx 12rpx rgba(15,23,42,.04)}
.order-head{display:flex;justify-content:space-between;font-size:24rpx;color:#98a2b3;margin-bottom:20rpx}
.order-status{color:#ff6a6b;font-weight:600}
.order-body{display:flex;gap:20rpx}
.order-thumb{width:140rpx;height:140rpx;border-radius:18rpx;flex-shrink:0}
.order-info{flex:1;display:flex;flex-direction:column;min-width:0}
.order-title{font-size:28rpx;font-weight:600;color:#1f2937;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.order-spec{margin-top:8rpx;font-size:24rpx;color:#98a2b3}
.order-price{margin-top:auto;font-size:30rpx;font-weight:700;color:#ff4142}
.order-foot{margin-top:24rpx;display:flex;justify-content:flex-end;gap:16rpx}
.primary-btn,.ghost-btn{min-width:160rpx;height:60rpx;padding:0 24rpx;border-radius:999rpx;font-size:24rpx;display:flex;align-items:center;justify-content:center}
.primary-btn{color:#fff;background:linear-gradient(135deg,#ff6a6b,#ff8d63);font-weight:600}
.ghost-btn{color:#667085;background:#f4f5f7}
