{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "refresh_interval": "1s"
  },
  "mappings": {
    "properties": {
      "id":            { "type": "long" },
      "spuCode":       { "type": "keyword" },
      "name":          { "type": "text", "analyzer": "ik_max_word", "search_analyzer": "ik_smart",
                         "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } } },
      "subtitle":      { "type": "text", "analyzer": "ik_max_word", "search_analyzer": "ik_smart",
                         "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } } },
      "description":   { "type": "text", "analyzer": "ik_max_word" },
      "categoryId":    { "type": "long" },
      "categoryName":  { "type": "keyword" },
      "brandId":       { "type": "long" },
      "brandName":     { "type": "keyword" },
      "price":         { "type": "double" },
      "oldPrice":      { "type": "double" },
      "discount":      { "type": "double" },
      "inventory":     { "type": "integer" },
      "salesCount":    { "type": "integer" },
      "commentCount":  { "type": "integer" },
      "collectCount":  { "type": "integer" },
      "status":        { "type": "integer" },
      "isPreSale":     { "type": "integer" },
      "mainImage":     { "type": "keyword" },
      "images":        { "type": "keyword" },
      "createTime":    { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
      "updateTime":    { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
      "suggestion":    { "type": "completion", "analyzer": "ik_smart",
                         "preserve_separators": true, "max_input_length": 50 }
    }
  }
}
