# =====================================================================
# shopkeeper-agent 环境变量配置
# 复制此文件为 .env 并填入真实值
# =====================================================================

# LLM 配置（必填）
LLM_API_KEY=replace-me
# LLM_MODEL_NAME=qwen3.6-flash
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# MySQL 配置（默认通过 host.docker.internal 访问宿主机）
# DB_META_HOST=host.docker.internal
# DB_META_PORT=3306
# DB_META_USER=mall_meta
# DB_META_PASSWORD=replace-me
# DB_META_DATABASE=meta

# DB_DW_HOST=host.docker.internal
# DB_DW_PORT=3306
# DB_DW_USER=mall_readonly
# DB_DW_PASSWORD=replace-me
# DB_DW_DATABASE=mall

# 向量库和搜索引擎（容器内默认用服务名，一般无需修改）
# QDRANT_HOST=qdrant
# QDRANT_PORT=6333

# EMBEDDING_HOST=embedding
# EMBEDDING_PORT=80

# ES_HOST=elasticsearch
# ES_PORT=9200
# ES_INDEX_NAME=mall_customer_service
