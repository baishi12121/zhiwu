<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hyf.malluserservice.mapper.UserTokenMapper">

    <resultMap id="BaseResultMap" type="com.hyf.malluserservice.entity.UserToken">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="token" column="token"/>
        <result property="client" column="client"/>
        <result property="expireAt" column="expire_at"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <!-- 插入会话 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user_token (user_id, token, client, expire_at)
        VALUES (#{userId}, #{token}, #{client}, #{expireAt})
    </insert>

    <!-- 根据 token 查询 -->
    <select id="selectByToken" resultMap="BaseResultMap">
        SELECT id, user_id, token, client, expire_at, create_time
        FROM user_token
        WHERE token = #{token}
    </select>

    <!-- 根据 token 删除 -->
    <delete id="deleteByToken">
        DELETE FROM user_token WHERE token = #{token}
    </delete>

    <!-- 根据 userId 删除全部会话 -->
    <delete id="deleteByUserId">
        DELETE FROM user_token WHERE user_id = #{userId}
    </delete>

</mapper>
