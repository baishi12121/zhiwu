<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hyf.mallseckillservice.mapper.UserAddressMapper">

    <select id="selectByIdAndUserId" resultType="com.hyf.mallseckillservice.entity.UserAddressDO">
        SELECT *
        FROM user_address
        WHERE id = #{id}
          AND user_id = #{userId}
        LIMIT 1
    </select>
</mapper>
